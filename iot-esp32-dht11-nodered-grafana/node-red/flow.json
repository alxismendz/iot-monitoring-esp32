        "z": "a513264aecee287d",
        "name": "Formatear para InfluxDB",
        "func": "// Extraer y convertir datos a float\ntry {\n    let temp = msg.payload.temperature || msg.payload.temperatura;\n    let hum = msg.payload.humedad;\n\n    if (typeof temp === 'undefined' || typeof hum === 'undefined') {\n        throw new Error(\"Datos incompletos\");\n    }\n\n    temp = parseFloat(temp);\n    hum = parseFloat(hum);\n\n    msg.measurement = \"dht11\";\n    msg.payload = {\n        temperature: temp,\n        humedad: hum\n    };\n    msg.tags = {\n        origen: \"ESP32\"\n    };\n\n    return msg;\n} catch (error) {\n    node.error(\"Error:\", error);\n    return null;\n}",
        "outputs": 1,
        "noerr": 0,
